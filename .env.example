# Local learning environment only. ./scripts/setup.sh creates .env with the
# first two values; add the POWERBI_* values yourself. Never commit .env.
POSTGRES_ADMIN_PASSWORD=generated-by-setup
VAULT_DEV_ROOT_TOKEN_ID=generated-by-setup

# Windows 10 with Docker Engine inside WSL only (see README):
# POSTGRES_PUBLISH=0.0.0.0:15432

# --- Real Power BI on-premises data gateway -------------------------------
# device            = sign in once as a gateway admin user (device code)
# service_principal = app-only; requires POWERBI_CLIENT_SECRET (see README)
POWERBI_AUTH_MODE=device
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=

# From ./scripts/powerbi.sh discover
POWERBI_GATEWAY_ID=
POWERBI_DATASOURCE_ID=

# Optional: semantic model to refresh after synchronization.
# Leave POWERBI_WORKSPACE_ID empty (or "me") for "My workspace".
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=

# PostgreSQL runs with TLS; keep the gateway connection encrypted.
POWERBI_ENCRYPTED_CONNECTION=Encrypted
POWERBI_PRIVACY_LEVEL=Organizational
